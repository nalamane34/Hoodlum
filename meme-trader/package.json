{
  "name": "meme-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Solana meme coin trader: pump.fun launch filter-first entries, smart-wallet copy trading, laddered exits, hard risk limits.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "keygen": "node dist/tools/keygen.js",
    "status": "node dist/tools/status.js",
    "panic": "node dist/tools/panic.js",
    "rulecheck": "node dist/tools/rulecheck.js",
    "backtest": "node dist/tools/backtest.js",
    "smoke": "node dist/tools/smoke.js",
    "dashboard": "node dist/tools/dashboard.js",
    "dashboard:dev": "tsx src/tools/dashboard.ts",
    "keygen:dev": "tsx src/tools/keygen.ts",
    "status:dev": "tsx src/tools/status.ts",
    "panic:dev": "tsx src/tools/panic.ts",
    "smoke:dev": "tsx src/tools/smoke.ts"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "2.0.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "https-proxy-agent": "^7.0.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
