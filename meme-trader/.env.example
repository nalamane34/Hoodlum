# ───────────────────────────── MODE ─────────────────────────────
# paper = simulate fills with live market data (default, no SOL at risk)
# live  = sign and send real transactions with WALLET_SECRET_KEY. No confirmations are asked.
MODE=paper

# ───────────────────────────── RPC ──────────────────────────────
# Public RPC is fine for paper mode and testing. Use a paid endpoint (Helius, QuickNode, Chainstack...) before going live.
# Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY  (the websocket URL is derived automatically, key included)
RPC_URL=https://api.mainnet-beta.solana.com
# Websocket for the trade feed. Derived from RPC_URL when omitted. Free provider plans often cap websocket
# connections/subscriptions (Helius free returned 429 after a day of per-token subscriptions); the public endpoint
# has handled the same load fine, so keep HTTP on your provider and put the websocket on the public endpoint:
RPC_WS_URL=wss://api.mainnet-beta.solana.com
# Low-priority background reads (outcome sampling of skipped launches, creator wallet history) go here, not to your paid
# plan. Public endpoint by default. Set it to RPC_URL only if you have credits to spare.
RPC_BACKGROUND_URL=https://api.mainnet-beta.solana.com
# Where requests go while the primary RPC is unusable: credits spent (Helius answers "429 max usage reached"), key rejected,
# or repeated errors. The bot keeps running on it instead of crashing and tries the primary again every RPC_FAILOVER_TRIP_SEC.
RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com
RPC_FAILOVER_TRIP_SEC=600
# Soft cap on background RPC calls per second (holder checks, wallet-age sampling). Trade execution is never throttled.
# Helius free tier allows 10 requests/s: use 5 here to leave headroom for trades.
RPC_MAX_RPS=8

# ───────────────────────────── WALLET ───────────────────────────
# Dedicated bot wallet ONLY. Generate one with `npm run keygen`, fund it with your risk budget, import it into Phantom to watch it.
# Accepts base58 (Phantom export format) or a JSON byte array. Required for MODE=live. Never commit this file.
WALLET_SECRET_KEY=

# ───────────────────────────── FEEDS ────────────────────────────
# Comma list: pumpportal (free launch feed), rpc (logsSubscribe firehose, also the trade/price feed), grpc (optional Yellowstone)
FEEDS=pumpportal,rpc
# How the rpc feed streams trades (needed for scoring, prices and exits):
#   watched  = one subscription per token we are observing or holding. Tiny bandwidth, fine on free RPC tiers. (default)
#   firehose = every pump.fun log line on the chain (~0.75 MB/s, ~65 GB/day, 85% of it failed bot transactions).
#              Catches same-slot bundles and cross-launch wallet rings better. Needs a paid RPC and a server connection.
TRADE_FEED=watched
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
# GRPC_ENDPOINT=https://your-yellowstone-endpoint
# GRPC_TOKEN=

# ───────────────────────────── SENDING ──────────────────────────
# rpc (sendTransaction with priority fee) | jito (block engine + tip) | helius (Helius Sender, tip >= 0.001 SOL)
SENDER=rpc
JITO_URL=https://mainnet.block-engine.jito.wtf
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
# Helius Sender needs a 0.001 SOL tip per transaction on all pathways (2% of a 0.05 SOL trade!).
# true = SWQoS-only pathway with a 0.000005 SOL minimum tip: cheaper, slightly less aggressive landing.
HELIUS_SWQOS_ONLY=false
# Tips (jito/helius). auto reads the live Jito tip floor and clamps to this range.
TIP_SOL_MIN=0.0005
TIP_SOL_MAX=0.003
# Priority fee in micro-lamports per compute unit. auto = 75th percentile of recent fees on the pump.fun program, clamped.
PRIORITY_FEE_MODE=auto
PRIORITY_FEE_MIN_MICRO=20000
PRIORITY_FEE_MAX_MICRO=3000000
PRIORITY_FEE_FIXED_MICRO=300000
CU_LIMIT=220000
MAX_TX_ATTEMPTS=3
SLIPPAGE_BUY_PCT=12
SLIPPAGE_SELL_PCT=20
SLIPPAGE_PANIC_PCT=45

# ───────────────────────────── RISK ─────────────────────────────
BUY_SOL=0.05
MAX_POSITIONS=3
MAX_DAILY_LOSS_SOL=0.5
MIN_RESERVE_SOL=0.05
MAX_CONSECUTIVE_LOSSES=4
LOSS_COOLDOWN_MIN=20

# ───────────────────────────── LAUNCH STRATEGY ──────────────────
LAUNCH_ENABLED=true
OBSERVE_SECONDS=25
# Buy before the window ends if this many unique buyers AND this much net SOL inflow appear with no red flags (0 buyers disables)
EARLY_TRIGGER_BUYERS=12
EARLY_TRIGGER_MIN_SOL=2.0
MIN_SCORE=55
MIN_UNIQUE_BUYERS=5
MAX_DEV_PCT=5
MAX_SINGLE_HOLDER_PCT=8
# 0 disables the on-chain top-holder check (1 getTokenLargestAccounts call per candidate).
# The public RPC rate-limits that call to the point of uselessness; the check silently degrades to "unknown" there. Paid RPCs serve it.
MAX_TOP10_PCT=30
MAX_BUNDLE_PCT=10
BUNDLE_MIN_WALLETS=3
MAX_SELL_RATIO=0.6
MIN_NET_INFLOW_SOL=1.0
# Launch market cap is ~28 SOL; graduation ~400 SOL. Do not chase above this.
MAX_ENTRY_MCAP_SOL=90
SKIP_MAYHEM=true
REQUIRE_SOCIALS=false
NAME_BLACKLIST=test,rug,scam,airdrop,presale
CREATOR_BLACKLIST=
# Hard-fail creators with fewer than this many prior transactions (0 = score penalty only)
CREATOR_MIN_TX=0
# How many early buyers to sample for wallet age / ring membership (RPC cost: 1 call each)
SAMPLE_BUYERS=4
RING_MAX_SAMPLED=2
# Keep tracking launches we observed and skipped for N minutes to log what they did. 0 disables.
SHADOW_TRACK_MINUTES=10
# Also track launches rejected before observation (mayhem, dev holdings...): never tradeable, costs 1 RPC call each. Off.
SHADOW_PREFILTERED=false

# ───────────────────────────── COPY STRATEGY ────────────────────
COPY_ENABLED=false
# Comma list of wallets to mirror (curate from Kolscan / GMGN / Cielo; re-check monthly)
COPY_WALLETS=
COPY_MIN_THEIR_SOL=0.2
COPY_BUY_SOL=0.05
# Only copy buys of tokens younger than N minutes (0 = any age)
COPY_MAX_TOKEN_AGE_MIN=0
COPY_FOLLOW_SELLS=true
COPY_USE_EXITS=true

# ───────────────────────────── EXITS ────────────────────────────
# multiple:percent-of-original-position, comma separated
TP_LADDER=2:50,3:25
TRAIL_PCT=30
TRAIL_ARM_MULT=1.3
STOP_LOSS_PCT=35
MAX_HOLD_MIN=10
MIN_GAIN_PCT_BY_MAX_HOLD=10
HARD_MAX_HOLD_MIN=90
STAGNATION_SECONDS=90
EXIT_ON_DEV_SELL=true
WHALE_DUMP_PCT=5
SELL_ON_GRADUATION=false

# ───────────────────────────── PAPER ────────────────────────────
PAPER_START_SOL=5
PAPER_SLIPPAGE_PCT=2
# Per-transaction network cost to charge in paper mode. SENDER=rpc on a quiet day is ~0.0001 SOL; 0.0005 is a fair
# pessimistic estimate for rpc. Use 0.0015 if you plan to send through Jito/Helius Sender with tips.
PAPER_FEE_SOL=0.0005

# ───────────────────────────── DASHBOARD ────────────────────────
# `npm run dashboard` (or the meme-trader-dashboard service) serves a read-only page from DATA_DIR.
# 127.0.0.1 = reach it through an SSH tunnel (ssh -L 8787:127.0.0.1:8787 ...). 0.0.0.0 = public; then DASHBOARD_TOKEN is required
# and you open http://SERVER_IP:8787/?token=... (also open port 8787 in the security group, ideally from your IP only).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_TOKEN=
# true when Caddy/nginx fronts the dashboard (deploy/expose.sh sets this): trusts X-Forwarded-* for rate limits and Secure cookies
DASHBOARD_TRUST_PROXY=false
# Days of launches / shadow outcomes the dashboard keeps in memory (and the bot keeps on disk)
DASHBOARD_KEEP_DAYS=7
DATA_KEEP_DAYS=7

# ───────────────────────────── MISC ─────────────────────────────
DATA_DIR=./data
LOG_LEVEL=info
STATUS_EVERY_SEC=30
# JUPITER_API_KEY=
